# Copy to demos/.env and fill in. Never commit .env.

# Gemini API key (free tier is enough), https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API key between OpenWebUI and the copilot service (any value)
COPILOT_API_KEY=sk-roomie-copilot-demo

# LiteLLM gateway (level 5). Defaults are fine for a local demo.
# Admin UI: http://localhost:4000/ui, user "admin", password = master key
LITELLM_MASTER_KEY=sk-litellm-demo-master-key
LITELLM_SALT_KEY=sk-litellm-demo-salt-key
